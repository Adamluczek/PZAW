<%- include("head_part.ejs")%>

<h1>Edytuj nazwę wyniku</h1>
<form action="/userScore/<%= userScore.id %>/edit" method="post">
  <label for="username">Nowa nazwa wyświetlana</label>
  <input
    type="text"
    id="username"
    name="username"
    value="<%= userScore.username %>"
    maxlength="14"
    required
  />
  <button type="submit" class="btn">Zapisz</button>
  <a href="/" class="btn">Anuluj</a>
</form>

<%- include("foot_part.ejs")%>
